      "title": "Eager Loading per evitar N+1",
      "tags": ["eloquent", "performance"],
      "problem": "Llistes d'elements que carreguen relacions fent moltes queries.",
      "steps": [
        "Detecta el N+1 (Laravel Debugbar / Telescope / logs).",
        "Afegeix eager loading amb with().",
        "Mesura diferència (temps i nº de queries)."
      ],
      "codeBlocks": [
        {
          "label": "Abans (N+1)",
          "code": "$posts = Post::latest()->get();\nforeach ($posts as $post) {\n  echo $post->author->name;\n}"
        },
        {
          "label": "Després (eager loading)",
          "code": "$posts = Post::with('author')->latest()->get();\nforeach ($posts as $post) {\n  echo $post->author->name;\n}"
        }
      ]
    },
